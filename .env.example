# Optional absolute path to terminal64.exe. At PyonTrading startup, this terminal is started
# once if it is not already running. It uses MT5's own saved login; PyonTrading never receives credentials.
PYON_MT5_TERMINAL_PATH=
# Set false to require launching MT5 manually. PyonTrading never relaunches MT5 after you close it.
PYON_MT5_AUTO_START=true
# Set only after selecting an exact broker-provided gold symbol in the dashboard.
PYON_SYMBOL=
PYON_HOST=127.0.0.1
PYON_PORT=8765
PYON_QUOTE_POLL_SECONDS=2
PYON_RESEARCH_POLL_SECONDS=30
PYON_RESEARCH_BOOTSTRAP_RETRY_SECONDS=21600
PYON_TRAINING_INTERVAL_SECONDS=21600
PYON_DELAYED_SECONDS=5
PYON_STALE_SECONDS=15

# Public weekly USD calendar (informational values) and official release-schedule refresh.
PYON_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
PYON_CALENDAR_TTL_SECONDS=600
PYON_OFFICIAL_MACRO_TTL_SECONDS=3600

# Optional startup defaults for exact symbols shown by *your connected broker*.
# Dashboard Context setup validates and persists these dynamically. Do not guess aliases.
PYON_DXY_SYMBOL=
PYON_US10Y_SYMBOL=
PYON_WTI_SYMBOL=
PYON_VOLATILITY_SYMBOL=

# Required only to call the local paper-trading kill-switch API.
# Keep this out of source control and never expose it in browser code.
PYON_OPERATOR_TOKEN=

